{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'email', 'identity'])",
        "identity": {
          ".validate": "newData.isString() && (newData.val() === 'Seller' || newData.val() === 'Buyer') && (!data.exists() || newData.val() === data.val())"
        },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "email": { ".validate": "newData.isString()" },
        "shopName": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "address": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "photoUrl": { ".validate": "newData.isString() && newData.val().beginsWith('https://')" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "photoUpdatedAt": { ".validate": "newData.isNumber()" }
      }
    }
  }
}

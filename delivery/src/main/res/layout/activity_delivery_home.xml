<ScrollView
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DELIVERY PARTNER"
            android:textColor="#C65A32"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="#FFF0E8"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"/>

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome back!"
            android:textColor="#222222"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready for your next delivery?"
            android:textColor="#888888"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"/>

        <!-- Rewards card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF0E8"
            android:padding="22dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR REWARD POINTS"
                android:textColor="#C65A32"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/pointsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 points"
                android:textColor="#222222"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete deliveries to earn more rewards!"
                android:textColor="#777777"
                android:textSize="13sp"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

        <!-- Available orders -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start delivering"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Orders"
                android:textColor="#222222"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find orders waiting for a delivery partner."
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/availableOrdersButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Explore orders"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF5722"/>

        </LinearLayout>

        <!-- My deliveries -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Deliveries"
                android:textColor="#222222"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View the orders you have volunteered to deliver."
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/myDeliveriesButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="View my deliveries"
                android:textAllCaps="false"
                android:textColor="#FF5722"
                android:backgroundTint="#FFF0E8"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
